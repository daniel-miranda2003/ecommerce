# Carvan - Backend (Medusa v2) - Solamente para desarrollo local.
# Copia este fichero a '.env' y cámbiale los secretos.
NODE_ENV=development

STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000

JWT_SECRET=carvan_jwt_secret_change_me
COOKIE_SECRET=carvan_cookie_secret_change_me
AUTH_MFA_ENCRYPTION_KEY=carvan_mfa_encryption_key_32bytes_placeholder!!

# hosts: nombres de servicio de docker-compose (no localhost)
DATABASE_URL=postgres://medusa:medusa_password@postgres:5432/medusa
REDIS_URL=redis://redis:6379
