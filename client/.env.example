# Carvan - Storefront (Next.js 15) - Solamente para desarrollo local.
# Copia este fichero a '.env.local'.
# La publishable key se genera al ejecutar `medusa db:migrate` (seed).
# Obténla con:
#   docker exec carvan-postgres sh -lc "PGPASSWORD=medusa_password psql -U medusa -h localhost -d medusa -c \"SELECT token FROM api_key WHERE type='publishable' AND deleted_at IS NULL;\""
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_RELLENA_TRAS_EL_SEED

# URL del backend Medusa (nombre de servicio dentro de la red Docker)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://server:9000

# Región por defecto del storefront
NEXT_PUBLIC_DEFAULT_REGION=dk

# URL base pública del storefront
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Stripe (opcional, sólo si se habilita el módulo de pago)
NEXT_PUBLIC_STRIPE_KEY=
